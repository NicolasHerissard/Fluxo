<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Finance.Android17.Presentation;assembly=Finance.Android17.Presentation"
             xmlns:local="clr-namespace:Finance.Android17.Maui"
             x:Class="Finance.Android17.Maui.SubscriptionsPage"
             x:Name="Page"
             x:DataType="vm:SubscriptionsViewModel"
             Style="{StaticResource AppPage}">
    <Grid RowDefinitions="Auto,*,Auto">
        <local:PageHeader Title="Abonnements" Subtitle="Anticipez vos prochaines échéances" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,12,20,28" Spacing="16">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <local:IconTile Icon="repeat" Tone="primary" Size="34" />
                                <Label Grid.Column="1" Text="Coût mensuel" Style="{StaticResource Eyebrow}" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding MonthlyTotal}" Style="{StaticResource SectionTitle}" FontSize="20" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <local:IconTile Icon="calendar" Tone="violet" Size="34" />
                                <Label Grid.Column="1" Text="Coût annuel" Style="{StaticResource Eyebrow}" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding AnnualTotal}" Style="{StaticResource SectionTitle}" FontSize="20" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="Nom" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}"><Entry Placeholder="Ex. Musique" Text="{Binding Name}" Style="{StaticResource InputEntry}" SemanticProperties.Description="Nom de l’abonnement" /></Border>
                        <Label Text="Montant" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Placeholder="9,99" Text="{Binding Amount}" Keyboard="Numeric" Style="{StaticResource InputEntry}" SemanticProperties.Description="Montant de l’abonnement" />
                                <Label Grid.Column="1" Text="{Binding CurrencySymbol}" Style="{StaticResource StrongLabel}" VerticalOptions="Center" Margin="8,0" />
                            </Grid>
                        </Border>
                        <Label Text="Fréquence" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}"><Picker ItemsSource="{Binding Frequencies}" SelectedItem="{Binding SelectedFrequency}" SemanticProperties.Description="Fréquence de prélèvement" /></Border>
                        <Label Text="Prochaine échéance" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}"><DatePicker Date="{Binding NextBillingDate}" SemanticProperties.Description="Prochaine échéance" /></Border>
                        <Label Text="{Binding ErrorMessage, Converter={StaticResource ErrorPrefixConverter}}" Style="{StaticResource ErrorLabel}" HorizontalTextAlignment="Start" />
                        <Button Text="{Binding SaveButtonText}" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Text="Annuler la modification" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" Style="{StaticResource TextButton}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Prochaines échéances" Style="{StaticResource SectionTitle}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
                <Border IsVisible="{Binding IsEmpty}" Style="{StaticResource Card}" Padding="24">
                    <VerticalStackLayout Spacing="10">
                        <local:IconTile Icon="repeat" Tone="primary" Size="56" HorizontalOptions="Center" />
                        <Label Text="Aucun abonnement. Ajoutez-en un pour calculer vos coûts mensuels et annuels." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Subscriptions}" Spacing="9">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubscriptionRow">
                            <Border Style="{StaticResource Card}" Padding="14,12,8,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" SemanticProperties.Hint="Touchez pour modifier cet abonnement">
                                    <local:IconTile Icon="repeat" Tone="warning" Size="42" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource StrongLabel}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Frequency}" Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Amount}" Style="{StaticResource StrongLabel}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding NextDate}" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                    <local:IconButton Grid.Column="3" Icon="trash" ButtonStyle="Small" VerticalOptions="Center"
                                                      Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}"
                                                      IconColor="{AppThemeBinding Light={StaticResource ExpenseInkLight}, Dark={StaticResource ExpenseInkDark}}"
                                                      Description="Supprimer cet abonnement" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" IsVisible="{Binding IsUndoVisible}" Style="{StaticResource Toast}" Margin="20,0,20,12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding UndoMessage}" Style="{StaticResource ToastText}" SemanticProperties.Description="{Binding UndoMessage}" />
                <Button Grid.Column="1" Text="Annuler" Command="{Binding UndoDeleteCommand}" Style="{StaticResource ToastAction}" SemanticProperties.Description="Annuler la suppression" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
