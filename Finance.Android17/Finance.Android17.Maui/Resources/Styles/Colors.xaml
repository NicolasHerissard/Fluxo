<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Palette de l'application. Les alias du modèle MAUI pointent vers les
         mêmes couleurs afin qu'un contrôle non stylé reste cohérent. -->
    <Color x:Key="PrimaryColor">#6750A4</Color>
    <Color x:Key="PrimaryPressedColor">#4F378B</Color>
    <Color x:Key="PrimarySoftColor">#9D82E2</Color>
    <Color x:Key="PrimaryContainerLight">#EADDFF</Color>
    <Color x:Key="PrimaryContainerDark">#4F378B</Color>
    <Color x:Key="OnPrimaryContainerLight">#21005D</Color>

    <Color x:Key="PageBackgroundLight">#F7F5FA</Color>
    <Color x:Key="PageBackgroundDark">#121212</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#211F26</Color>
    <Color x:Key="SurfaceContainerLight">#EEE8F4</Color>
    <Color x:Key="SurfaceContainerDark">#332D41</Color>
    <Color x:Key="SurfaceElevatedLight">#FFFBFE</Color>
    <Color x:Key="SurfaceElevatedDark">#1C1B1F</Color>
    <Color x:Key="SkeletonLight">#E8E2ED</Color>
    <Color x:Key="SkeletonDark">#2B2930</Color>

    <Color x:Key="TextPrimaryLight">#201A2B</Color>
    <Color x:Key="TextPrimaryDark">#F2EDF7</Color>
    <Color x:Key="TextSecondaryLight">#625B71</Color>
    <Color x:Key="TextSecondaryDark">#CAC4D0</Color>
    <Color x:Key="PlaceholderLight">#6B6672</Color>
    <Color x:Key="PlaceholderDark">#AEA9B4</Color>
    <Color x:Key="OutlineLight">#E7E0EC</Color>
    <Color x:Key="OutlineDark">#49454F</Color>

    <Color x:Key="DangerColor">#B3261E</Color>
    <Color x:Key="DangerDarkColor">#FFB4AB</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="SuccessDarkColor">#81C995</Color>
    <Color x:Key="HeroGradientStartColor">#7658B5</Color>
    <Color x:Key="HeroGradientEndColor">#51358D</Color>
    <Color x:Key="HeroTextColor">#FFFFFF</Color>
    <Color x:Key="HeroMutedTextColor">#F0E7FF</Color>
    <Color x:Key="SliderRedColor">#FF6B6B</Color>
    <Color x:Key="SliderGreenColor">#51CF66</Color>
    <Color x:Key="SliderBlueColor">#4DABF7</Color>
    <Color x:Key="ScrimColor">#99000000</Color>
    <Color x:Key="FabShadowColor">#55000000</Color>

    <Color x:Key="Primary">#6750A4</Color>
    <Color x:Key="PrimaryDark">#6750A4</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#EADDFF</Color>
    <Color x:Key="SecondaryDarkText">#D0BCFF</Color>
    <Color x:Key="Tertiary">#4F378B</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#6750A4</Color>
    <Color x:Key="MidnightBlue">#201A2B</Color>
    <Color x:Key="OffBlack">#121212</Color>

    <Color x:Key="Gray100">#F2EDF7</Color>
    <Color x:Key="Gray200">#E7E0EC</Color>
    <Color x:Key="Gray300">#CAC4D0</Color>
    <Color x:Key="Gray400">#938F99</Color>
    <Color x:Key="Gray500">#79747E</Color>
    <Color x:Key="Gray600">#625B71</Color>
    <Color x:Key="Gray900">#201A2B</Color>
    <Color x:Key="Gray950">#121212</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
