<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette « indigo » issue de la maquette Figma. Chaque couleur de thème existe en deux
         variantes, XxxLight et XxxDark, toujours associées par AppThemeBinding : le changement
         de thème (clair, sombre ou celui de l'appareil) s'applique donc partout sans recharger.
         Pour Android, voir aussi Platforms\Android\Resources\values\colors.xml. -->

    <!-- Fonds et surfaces -->
    <Color x:Key="PageBackgroundLight">#F6F5FF</Color>
    <Color x:Key="PageBackgroundDark">#0B0E1A</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#141829</Color>
    <Color x:Key="SurfaceContainerLight">#EFEDFB</Color>
    <Color x:Key="SurfaceContainerDark">#1A1F35</Color>
    <Color x:Key="SurfaceElevatedLight">#FFFFFF</Color>
    <Color x:Key="SurfaceElevatedDark">#0F1322</Color>
    <Color x:Key="ToggleBackgroundLight">#E9E7F8</Color>
    <Color x:Key="ToggleBackgroundDark">#0F1322</Color>
    <Color x:Key="NavBarLight">#EEECFB</Color>
    <Color x:Key="NavBarDark">#10131F</Color>
    <Color x:Key="HoverLight">#E0DEFA</Color>
    <Color x:Key="HoverDark">#232948</Color>
    <Color x:Key="TrackLight">#E0DEF3</Color>
    <Color x:Key="TrackDark">#262B44</Color>
    <Color x:Key="SkeletonLight">#E4E2F3</Color>
    <Color x:Key="SkeletonDark">#1F2339</Color>

    <!-- Traits -->
    <Color x:Key="OutlineLight">#E2E0F0</Color>
    <Color x:Key="OutlineDark">#262B44</Color>
    <Color x:Key="LineSoftLight">#EBE9F7</Color>
    <Color x:Key="LineSoftDark">#1F2339</Color>

    <!-- Textes -->
    <Color x:Key="TextPrimaryLight">#1E1B4B</Color>
    <Color x:Key="TextPrimaryDark">#E8EAFB</Color>
    <Color x:Key="TextSecondaryLight">#645F8C</Color>
    <Color x:Key="TextSecondaryDark">#8D93B8</Color>
    <Color x:Key="TextFaintLight">#7A769F</Color>
    <Color x:Key="TextFaintDark">#7B82A8</Color>
    <Color x:Key="PlaceholderLight">#7A769F</Color>
    <Color x:Key="PlaceholderDark">#6D7396</Color>

    <!-- Accent principal -->
    <Color x:Key="PrimaryLight">#4338CA</Color>
    <Color x:Key="PrimaryDark">#8B9CFF</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#0B0E1A</Color>
    <Color x:Key="PrimaryContainerLight">#E8E6FB</Color>
    <Color x:Key="PrimaryContainerDark">#232A52</Color>

    <!-- Dépenses, alertes et teintes complémentaires (rose, ambre, violet, bleu) -->
    <Color x:Key="ExpenseAccentColor">#FB7185</Color>
    <Color x:Key="ExpenseSoftLight">#FFE4E8</Color>
    <Color x:Key="ExpenseSoftDark">#3A1F2B</Color>
    <Color x:Key="ExpenseInkLight">#E11D48</Color>
    <Color x:Key="ExpenseInkDark">#FDA4AF</Color>
    <Color x:Key="WarningSoftLight">#FEF3C7</Color>
    <Color x:Key="WarningSoftDark">#3A2E12</Color>
    <Color x:Key="WarningInkLight">#B45309</Color>
    <Color x:Key="WarningInkDark">#FCD34D</Color>
    <Color x:Key="SuccessSoftLight">#DCFCE7</Color>
    <Color x:Key="SuccessSoftDark">#143324</Color>
    <Color x:Key="SuccessInkLight">#15803D</Color>
    <Color x:Key="SuccessInkDark">#86EFAC</Color>
    <Color x:Key="VioletSoftLight">#EDE9FE</Color>
    <Color x:Key="VioletSoftDark">#2C2350</Color>
    <Color x:Key="VioletInkLight">#7C3AED</Color>
    <Color x:Key="VioletInkDark">#C4B5FD</Color>
    <Color x:Key="BlueSoftLight">#E0E7FF</Color>
    <Color x:Key="BlueSoftDark">#1F2A52</Color>
    <Color x:Key="BlueInkLight">#4F46E5</Color>
    <Color x:Key="BlueInkDark">#A5B4FC</Color>

    <!-- Couleurs fixes (identiques dans les deux thèmes) -->
    <Color x:Key="IncomeBarColor">#6366F1</Color>
    <Color x:Key="ExpenseBarColor">#FB7185</Color>
    <Color x:Key="SliderRedColor">#FF6B6B</Color>
    <Color x:Key="SliderGreenColor">#51CF66</Color>
    <Color x:Key="SliderBlueColor">#4DABF7</Color>
    <Color x:Key="ScrimColor">#99000000</Color>
    <Color x:Key="FabShadowColor">#55000000</Color>
    <Color x:Key="NotificationDotLight">#FB7185</Color>
    <Color x:Key="NotificationDotDark">#FB7185</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
</ResourceDictionary>
