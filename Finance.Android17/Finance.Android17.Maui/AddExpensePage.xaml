<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Finance.Android17.Presentation;assembly=Finance.Android17.Presentation"
             xmlns:local="clr-namespace:Finance.Android17.Maui"
             x:Class="Finance.Android17.Maui.AddExpensePage"
             x:Name="AddPage"
             x:DataType="vm:AddExpenseViewModel"
             Title="{Binding PageTitle}"
             NavigationPage.HasNavigationBar="False"
             Style="{StaticResource AppPage}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,18,20,24" Spacing="22">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="Saisie rapide" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1" />
                    </VerticalStackLayout>
                    <local:IconButton Grid.Column="1" Icon="x" ButtonStyle="Tile" VerticalOptions="Start" Description="Fermer sans enregistrer" Clicked="OnCancelClicked" />
                </Grid>

                <Border Style="{StaticResource Card}" Padding="16,18">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Montant" Style="{StaticResource Eyebrow}" HorizontalTextAlignment="Center" />
                        <Grid ColumnDefinitions="48,190,48" HorizontalOptions="Center">
                            <Entry x:Name="AmountEntry" Grid.Column="1" Placeholder="0,00" Text="{Binding Amount}" Keyboard="Numeric" ReturnType="Done"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="48" HorizontalTextAlignment="Center" BackgroundColor="Transparent"
                                   ClearButtonVisibility="Never" SemanticProperties.Description="Montant de la transaction" />
                            <Label Grid.Column="2" Text="{Binding CurrencySymbol}" Style="{StaticResource SectionTitle}" FontSize="28" VerticalOptions="Center" HorizontalOptions="Start" Margin="8,0,0,0" />
                        </Grid>
                        <Button Text="Scanner un ticket" Clicked="OnScanReceiptClicked" Style="{StaticResource TextButton}" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Catégorie" Style="{StaticResource SectionTitle}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
                    <CollectionView ItemsSource="{Binding CategoryOptions}" SelectionMode="None" HeightRequest="68">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExpenseCategoryOption">
                                <Grid Padding="2">
                                    <Border Padding="16,10" SemanticProperties.Description="{Binding AccessibilityDescription}" BackgroundColor="{Binding Color}" Stroke="{Binding SelectionStroke}" StrokeThickness="{Binding SelectionStrokeThickness}" StrokeShape="RoundRectangle 14" MinimumHeightRequest="52">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference AddPage}, Path=BindingContext.SelectCategoryCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Name}" TextColor="{Binding Color, Converter={StaticResource ColorContrastConverter}}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                            <Border Grid.Column="1" IsVisible="{Binding IsSelected}" WidthRequest="22" HeightRequest="22" Padding="0" BackgroundColor="{StaticResource White}" StrokeThickness="0" StrokeShape="RoundRectangle 11" VerticalOptions="Center">
                                                <local:IconView Icon="check" WidthRequest="14" HeightRequest="14" StrokeWidth="2.6" IconColor="{StaticResource PrimaryLight}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Date" Style="{StaticResource SectionTitle}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="Aujourd’hui" Command="{Binding SelectDateCommand}" CommandParameter="Aujourd’hui" Style="{StaticResource ChipButton}" CornerRadius="10" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsTodaySelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                                    <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                    <Setter Property="Text" Value="✓ Aujourd’hui" />
                                    <Setter Property="SemanticProperties.Description" Value="Aujourd’hui, sélectionné" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="Hier" Command="{Binding SelectDateCommand}" CommandParameter="Hier" Style="{StaticResource ChipButton}" CornerRadius="10" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsYesterdaySelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                                    <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                    <Setter Property="Text" Value="✓ Hier" />
                                    <Setter Property="SemanticProperties.Description" Value="Hier, sélectionné" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2" Text="{Binding OtherDateText}" Clicked="OnOtherDateClicked" Style="{StaticResource ChipButton}" CornerRadius="10" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsOtherDateSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                                    <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                    <Setter Property="SemanticProperties.Description" Value="Autre date, sélectionné" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Border IsVisible="{Binding IsCustomDateVisible}" Style="{StaticResource InputField}">
                        <DatePicker x:Name="CustomDatePicker" Date="{Binding Date}" Format="dddd d MMMM yyyy" MinimumHeightRequest="50" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Note" Style="{StaticResource SectionTitle}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource InputField}">
                        <Entry x:Name="NoteEntry" Placeholder="Facultatif · ex. Courses de la semaine" Text="{Binding Description}" Style="{StaticResource InputEntry}" ReturnType="Done" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Padding="20,12,20,18" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource StatusLabel}" />
                <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsSaveEnabled}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
