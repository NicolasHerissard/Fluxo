<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Finance.Android17.Presentation;assembly=Finance.Android17.Presentation"
             xmlns:local="clr-namespace:Finance.Android17.Maui"
             x:Class="Finance.Android17.Maui.IncomePage"
             x:Name="Page"
             x:DataType="vm:IncomeViewModel"
             Style="{StaticResource AppPage}">
    <Grid RowDefinitions="Auto,*,Auto">
        <local:PageHeader Title="Revenus &amp; épargne" Subtitle="Ce que vous recevez et ce que vous mettez de côté" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,12,20,28" Spacing="16" MaximumWidthRequest="760" HorizontalOptions="Fill">
                <!-- Synthèse du mois -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Solde actuel" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding CurrentBalance}" Style="{StaticResource DisplayAmount}" SemanticProperties.Description="Solde actuel" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="5">
                                <local:IconTile Icon="arrow-down-left" Tone="success" Size="32" HorizontalOptions="Start" />
                                <Label Text="Revenus du mois" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding MonthIncome}" Style="{StaticResource StrongLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <local:IconTile Icon="trending-up" Tone="violet" Size="32" HorizontalOptions="Start" />
                                <Label Text="Reste ce mois-ci" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding MonthNet}" Style="{StaticResource StrongLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="5">
                                <local:IconTile Icon="calendar" Tone="primary" Size="32" HorizontalOptions="Start" />
                                <Label Text="Fin de mois" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding ForecastBalance}" Style="{StaticResource StrongLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{Binding ExpectedIncome, StringFormat='Encore attendu d’ici la fin du mois : {0}'}" Style="{StaticResource MutedLabel}" FontSize="14" />
                        <Label Text="Reste ce mois-ci = revenus − dépenses du mois. Fin de mois = solde estimé au dernier jour, avec revenus récurrents et abonnements à venir." Style="{StaticResource CaptionLabel}" TextColor="{AppThemeBinding Light={StaticResource TextFaintLight}, Dark={StaticResource TextFaintDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Revenus -->
                <Label Text="Revenus" Style="{StaticResource SectionTitle}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
                <Button Text="+  Ajouter un revenu" Command="{Binding ShowIncomeFormCommand}" IsVisible="{Binding IsIncomeFormClosed}" Style="{StaticResource PrimaryButton}" SemanticProperties.Description="Ajouter un revenu" />
                <Border IsVisible="{Binding IsIncomeFormVisible}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding IncomeFormTitle}" Style="{StaticResource StrongLabel}" />
                        <VerticalStackLayout Spacing="4"><Label Text="Origine du revenu" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputField}"><Entry MaxLength="120" Text="{Binding IncomeDescription}" Placeholder="Origine du revenu (ex. Salaire)" Style="{StaticResource InputEntry}" SemanticProperties.Description="Origine du revenu" /></Border></VerticalStackLayout>
                        <VerticalStackLayout Spacing="4"><Label Text="Montant" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputField}"><Entry Text="{Binding IncomeAmount}" Placeholder="Montant" Keyboard="Numeric" Style="{StaticResource InputEntry}" SemanticProperties.Description="Montant du revenu" /></Border></VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding CanChooseRepeat}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Se répète" Style="{StaticResource StrongLabel}" />
                                <Label Text="Salaire, loyer perçu… ajouté automatiquement à chaque échéance" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding IncomeRepeats}" VerticalOptions="Center" SemanticProperties.Description="Le revenu se répète" />
                        </Grid>
                        <Border IsVisible="{Binding IncomeRepeats}" Style="{StaticResource InputField}"><Picker ItemsSource="{Binding Frequencies}" SelectedItem="{Binding SelectedFrequency}" SemanticProperties.Description="Fréquence du revenu" /></Border>
                        <Label Text="{Binding IncomeDateLabel}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}"><DatePicker Date="{Binding IncomeDate}" SemanticProperties.Description="{Binding IncomeDateLabel}" /></Border>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Text="Enregistrer le revenu" Command="{Binding SaveIncomeCommand}" Style="{StaticResource PrimaryButton}" SemanticProperties.Description="Enregistrer le revenu" />
                            <Button Grid.Column="1" Text="Annuler" Command="{Binding CancelIncomeEditCommand}" Style="{StaticResource TextButton}" SemanticProperties.Description="Fermer sans enregistrer" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="À venir (revenus récurrents)" Style="{StaticResource SectionTitle}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecurringIncomes}" Spacing="9">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecurringIncomeRow">
                            <Border Style="{StaticResource Card}" Padding="14,12,8,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditRecurringIncomeCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" SemanticProperties.Hint="Touchez pour modifier ce revenu récurrent">
                                    <local:IconTile Icon="repeat" Tone="blue" Size="42" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource StrongLabel}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Frequency}" Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Amount}" Style="{StaticResource StrongLabel}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding NextDate}" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                    <local:IconButton Grid.Column="3" Icon="trash" ButtonStyle="Small" VerticalOptions="Center"
                                                      Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteRecurringIncomeCommand}" CommandParameter="{Binding .}"
                                                      IconColor="{AppThemeBinding Light={StaticResource ExpenseInkLight}, Dark={StaticResource ExpenseInkDark}}"
                                                      Description="Supprimer ce revenu récurrent" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Reçus" Style="{StaticResource SectionTitle}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Incomes}" Spacing="9">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:IncomeRow">
                            <Border Style="{StaticResource Card}" Padding="14,12,8,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditIncomeCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" SemanticProperties.Hint="Touchez pour modifier ce revenu">
                                    <local:IconTile Icon="arrow-down-left" Tone="success" Size="42" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Description}" Style="{StaticResource StrongLabel}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Date}" Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Amount}" Style="{StaticResource StrongLabel}" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource SuccessInkLight}, Dark={StaticResource SuccessInkDark}}" />
                                    <local:IconButton Grid.Column="3" Icon="trash" ButtonStyle="Small" VerticalOptions="Center"
                                                      Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteIncomeCommand}" CommandParameter="{Binding .}"
                                                      IconColor="{AppThemeBinding Light={StaticResource ExpenseInkLight}, Dark={StaticResource ExpenseInkDark}}"
                                                      Description="Supprimer ce revenu" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Objectifs d'épargne -->
                <VerticalStackLayout BindingContext="{Binding Goals}" x:DataType="vm:SavingsGoalsViewModel" Spacing="16">
                    <Label Text="Objectifs d’épargne" Style="{StaticResource SectionTitle}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
                    <Button Text="+  Ajouter un objectif" Command="{Binding ShowGoalFormCommand}" IsVisible="{Binding IsGoalFormClosed}" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Ajouter un objectif d’épargne" />
                    <Border IsVisible="{Binding IsGoalFormVisible}" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding GoalFormTitle}" Style="{StaticResource StrongLabel}" />
                            <VerticalStackLayout Spacing="4"><Label Text="Nom de l’objectif" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputField}"><Entry MaxLength="120" Text="{Binding GoalName}" Placeholder="Nom de l’objectif" Style="{StaticResource InputEntry}" SemanticProperties.Description="Nom de l’objectif" /></Border></VerticalStackLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="4"><Label Text="Montant cible" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputField}"><Entry Text="{Binding GoalTargetAmount}" Placeholder="Montant cible" Keyboard="Numeric" Style="{StaticResource InputEntry}" SemanticProperties.Description="Montant cible" /></Border></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Déjà épargné" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputField}"><Entry Text="{Binding GoalSavedAmount}" Placeholder="Déjà épargné" Keyboard="Numeric" Style="{StaticResource InputEntry}" SemanticProperties.Description="Montant déjà épargné" /></Border></VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Ajouter une date cible" Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding GoalHasTargetDate}" SemanticProperties.Description="Ajouter une date cible" />
                            </Grid>
                            <Border IsVisible="{Binding GoalHasTargetDate}" Style="{StaticResource InputField}"><DatePicker Date="{Binding GoalTargetDate}" SemanticProperties.Description="Date cible de l’objectif" /></Border>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button Text="Enregistrer" Command="{Binding SaveGoalCommand}" Style="{StaticResource PrimaryButton}" SemanticProperties.Description="Enregistrer l’objectif" />
                                <Button Grid.Column="1" Text="Annuler" Command="{Binding CancelGoalEditCommand}" Style="{StaticResource TextButton}" SemanticProperties.Description="Annuler la modification de l’objectif" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SavingsGoals}" Spacing="9">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SavingsGoalRow">
                                <Border Style="{StaticResource Card}" Padding="14,12,8,14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.Goals.EditGoalCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10" SemanticProperties.Hint="Touchez pour modifier cet objectif">
                                        <local:IconTile Icon="target" Tone="violet" Size="42" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource StrongLabel}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Saved, StringFormat='{0} épargnés'}" Style="{StaticResource MutedLabel}" />
                                        </VerticalStackLayout>
                                        <local:IconButton Grid.Column="2" Icon="trash" ButtonStyle="Small" VerticalOptions="Center"
                                                          Command="{Binding Source={x:Reference Page}, Path=BindingContext.Goals.DeleteGoalCommand}" CommandParameter="{Binding .}"
                                                          IconColor="{AppThemeBinding Light={StaticResource ExpenseInkLight}, Dark={StaticResource ExpenseInkDark}}"
                                                          Description="Supprimer cet objectif" />
                                        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,6,0">
                                            <ProgressBar Progress="{Binding Progress}" ProgressColor="{AppThemeBinding Light={StaticResource VioletInkLight}, Dark={StaticResource VioletInkDark}}"
                                                         BackgroundColor="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" VerticalOptions="Center" HeightRequest="8" />
                                            <Label Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource StrongLabel}" FontSize="14" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding StatusText}" Style="{StaticResource StatusLabel}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ExpenseInkLight}, Dark={StaticResource ExpenseInkDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Label Text="{Binding StatusText}" Style="{StaticResource StatusLabel}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ExpenseInkLight}, Dark={StaticResource ExpenseInkDark}}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" IsVisible="{Binding IsUndoVisible}" Style="{StaticResource Toast}" Margin="20,0,20,12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding UndoMessage}" Style="{StaticResource ToastText}" SemanticProperties.Description="{Binding UndoMessage}" />
                <Button Grid.Column="1" Text="Annuler" Command="{Binding UndoDeleteCommand}" Style="{StaticResource ToastAction}" SemanticProperties.Description="Annuler la suppression" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
