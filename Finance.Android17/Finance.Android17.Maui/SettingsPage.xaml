<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Finance.Android17.Presentation;assembly=Finance.Android17.Presentation"
             x:Class="Finance.Android17.Maui.SettingsPage"
             x:Name="Page"
             x:DataType="vm:SettingsViewModel"
             Style="{StaticResource AppPage}">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,100" Spacing="18" MaximumWidthRequest="760" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="1"><Label Text="Réglages" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1" /><Label Text="Sécurité, automatisation et préférences" Style="{StaticResource MutedLabel}" /></VerticalStackLayout>

            <Label Text="Confidentialité" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Masquer les montants" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Remplace les montants par des points" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding HideAmounts}" SemanticProperties.Description="Masquer les montants" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Déverrouillage biométrique" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Empreinte ou visage après le premier PIN" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding BiometricsEnabled}" IsEnabled="{Binding BiometricsAvailable}" SemanticProperties.Description="Déverrouillage biométrique" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Verrouillage automatique" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Après une période d’inactivité" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Picker Grid.Column="1" ItemsSource="{Binding AutoLockChoices}" SelectedItem="{Binding AutoLockMinutes}" Title="Minutes" MinimumWidthRequest="120" SemanticProperties.Description="Verrouillage automatique, en minutes" /></Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Modifier le code PIN" Style="{StaticResource SectionTitle}" FontSize="18" />
                    <Border Style="{StaticResource InputField}"><Entry Placeholder="Code PIN actuel" Text="{Binding CurrentPin}" IsPassword="True" Keyboard="Numeric" Style="{StaticResource InputEntry}" SemanticProperties.Description="Code PIN actuel" /></Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Style="{StaticResource InputField}"><Entry Placeholder="Nouveau PIN" Text="{Binding NewPin}" IsPassword="True" Keyboard="Numeric" Style="{StaticResource InputEntry}" SemanticProperties.Description="Nouveau code PIN" /></Border>
                        <Border Grid.Column="1" Style="{StaticResource InputField}"><Entry Placeholder="Confirmation" Text="{Binding ConfirmPin}" IsPassword="True" Keyboard="Numeric" Style="{StaticResource InputEntry}" SemanticProperties.Description="Confirmation du nouveau code PIN" /></Border>
                    </Grid>
                    <Button Text="Changer le code PIN" Command="{Binding ChangePinCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Préférences financières" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Devise principale" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Utilisée pour les nouveaux montants" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Picker Grid.Column="1" ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" MinimumWidthRequest="120" SemanticProperties.Description="Devise principale" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Label Text="Budget mensuel global" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource InputField}"><Entry Placeholder="Ex. 1500" Text="{Binding MonthlyBudget}" Keyboard="Numeric" Style="{StaticResource InputEntry}" SemanticProperties.Description="Budget mensuel global" /></Border>
                        <Button Grid.Column="1" Text="Enregistrer" Command="{Binding SaveBudgetCommand}" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Enregistrer le budget mensuel" />
                    </Grid>
                    <Label Text="Laissez vide pour désactiver le suivi du budget." Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Abonnements" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Créer les dépenses automatiquement" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Ajoute chaque prélèvement à son échéance, sans doublon" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding AutoCreateSubscriptionExpenses}" SemanticProperties.Description="Créer les dépenses des abonnements automatiquement" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Rappels d’échéance" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Notifications programmées, même application fermée" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding SubscriptionRemindersEnabled}" SemanticProperties.Description="Rappels d’échéance" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Prévenir avant" Style="{StaticResource BodyLabel}" VerticalOptions="Center" /><Picker Grid.Column="1" ItemsSource="{Binding ReminderDayChoices}" SelectedItem="{Binding SubscriptionReminderDays}" IsEnabled="{Binding SubscriptionRemindersEnabled}" MinimumWidthRequest="120" SemanticProperties.Description="Prévenir avant l’échéance, en jours" /></Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Revenus" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Créer les revenus récurrents automatiquement" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                        <Label Text="Ajoute les salaires et autres revenus arrivés à échéance" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding AutoCreateRecurringIncomes}" SemanticProperties.Description="Créer les revenus récurrents automatiquement" />
                </Grid>
            </Border>

            <Label Text="Ajout rapide" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Catégorie par défaut" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Utilisée si aucune catégorie récente n’est disponible" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Picker Grid.Column="1" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding DefaultCategory}" Title="Aucune" MinimumWidthRequest="140" SemanticProperties.Description="Catégorie par défaut" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Mémoriser la dernière catégorie" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Accélère les dépenses habituelles" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding RememberLastCategory}" SemanticProperties.Description="Mémoriser la dernière catégorie" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Après l’enregistrement" Style="{StaticResource BodyLabel}" VerticalOptions="Center" /><Picker Grid.Column="1" ItemsSource="{Binding AfterSaveChoices}" SelectedItem="{Binding SelectedAfterSaveBehavior}" MinimumWidthRequest="150" SemanticProperties.Description="Comportement après l’enregistrement" /></Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Apparence" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Thème" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Appliqué immédiatement" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Picker Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" MinimumWidthRequest="130" SemanticProperties.Description="Thème" /></Grid></Border>

            <Label Text="Catégories" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout VerticalOptions="Center"><Label Text="Gérer les catégories" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Créer, modifier, colorer et fixer un budget" Style="{StaticResource MutedLabel}" /></VerticalStackLayout>
                    <Button Grid.Column="1" Text="Ouvrir" Clicked="OnOpenCategoriesClicked" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Ouvrir la gestion des catégories" />
                </Grid>
            </Border>

            <Label Text="Mes données" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout VerticalOptions="Center"><Label Text="Export et sauvegarde" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Export CSV, sauvegarde chiffrée et restauration" Style="{StaticResource MutedLabel}" /></VerticalStackLayout>
                    <Button Grid.Column="1" Text="Ouvrir" Clicked="OnOpenDataClicked" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Ouvrir l’export et la sauvegarde" />
                </Grid>
            </Border>

            <Label Text="Zone sensible" Style="{StaticResource SectionTitle}" TextColor="{AppThemeBinding Light={StaticResource DangerColor}, Dark={StaticResource DangerDarkColor}}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}" Stroke="{StaticResource DangerColor}">
                <VerticalStackLayout Spacing="9">
                    <Label Text="Supprimer toutes les données financières" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                    <Label Text="Efface définitivement dépenses, revenus, objectifs, abonnements et catégories personnalisées." Style="{StaticResource MutedLabel}" />
                    <Button Text="Tout supprimer" Clicked="OnDeleteAllClicked" Style="{StaticResource DangerButton}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Verrouiller maintenant" Clicked="OnLockClicked" Style="{StaticResource PrimaryButton}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />
            <Label Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light={StaticResource SuccessColor}, Dark={StaticResource SuccessDarkColor}}" HorizontalTextAlignment="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding StatusIsError}" Value="True">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerColor}, Dark={StaticResource DangerDarkColor}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label x:Name="VersionLabel" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
