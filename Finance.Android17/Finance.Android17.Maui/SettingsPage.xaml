<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Finance.Android17.Presentation;assembly=Finance.Android17.Presentation"
             xmlns:domain="clr-namespace:Finance.Android17.Domain;assembly=Finance.Android17.Domain"
             x:Class="Finance.Android17.Maui.SettingsPage"
             x:Name="Page"
             x:DataType="vm:SettingsViewModel"
             Style="{StaticResource AppPage}">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,100" Spacing="18" MaximumWidthRequest="760" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="1"><Label Text="Réglages" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1" /><Label Text="Sécurité, automatisation et préférences" Style="{StaticResource MutedLabel}" /></VerticalStackLayout>

            <Label Text="Confidentialité" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Masquer les montants" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Remplace les montants par des points" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding HideAmounts}" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Déverrouillage biométrique" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Empreinte ou visage après le premier PIN" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding BiometricsEnabled}" IsEnabled="{Binding BiometricsAvailable}" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Verrouillage automatique" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Après une période d’inactivité" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Picker Grid.Column="1" ItemsSource="{Binding AutoLockChoices}" SelectedItem="{Binding AutoLockMinutes}" Title="Minutes" MinimumWidthRequest="120" /></Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Modifier le code PIN" Style="{StaticResource SectionTitle}" FontSize="18" />
                    <Border Style="{StaticResource InputField}"><Entry Placeholder="Code PIN actuel" Text="{Binding CurrentPin}" IsPassword="True" Keyboard="Numeric" Style="{StaticResource InputEntry}" /></Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Style="{StaticResource InputField}"><Entry Placeholder="Nouveau PIN" Text="{Binding NewPin}" IsPassword="True" Keyboard="Numeric" Style="{StaticResource InputEntry}" /></Border>
                        <Border Grid.Column="1" Style="{StaticResource InputField}"><Entry Placeholder="Confirmation" Text="{Binding ConfirmPin}" IsPassword="True" Keyboard="Numeric" Style="{StaticResource InputEntry}" /></Border>
                    </Grid>
                    <Button Text="Changer le code PIN" Command="{Binding ChangePinCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Préférences financières" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Devise principale" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Utilisée pour les nouveaux montants" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Picker Grid.Column="1" ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" MinimumWidthRequest="120" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Label Text="Budget mensuel global" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource InputField}"><Entry Placeholder="Ex. 1500" Text="{Binding MonthlyBudget}" Keyboard="Numeric" Style="{StaticResource InputEntry}" /></Border>
                        <Button Grid.Column="1" Text="Enregistrer" Command="{Binding SaveBudgetCommand}" Style="{StaticResource SecondaryButton}" />
                    </Grid>
                    <Label Text="Laissez vide pour désactiver le suivi du budget." Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Abonnements" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Créer les dépenses automatiquement" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Ajoute chaque prélèvement à son échéance, sans doublon" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding AutoCreateSubscriptionExpenses}" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Rappels d’échéance" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Notifications programmées, même application fermée" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding SubscriptionRemindersEnabled}" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Prévenir avant" Style="{StaticResource BodyLabel}" VerticalOptions="Center" /><Picker Grid.Column="1" ItemsSource="{Binding ReminderDayChoices}" SelectedItem="{Binding SubscriptionReminderDays}" IsEnabled="{Binding SubscriptionRemindersEnabled}" MinimumWidthRequest="120" /></Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Revenus" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Créer les revenus récurrents automatiquement" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                        <Label Text="Ajoute les salaires et autres revenus arrivés à échéance" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding AutoCreateRecurringIncomes}" />
                </Grid>
            </Border>

            <Label Text="Ajout rapide" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Catégorie par défaut" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Utilisée si aucune catégorie récente n’est disponible" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Picker Grid.Column="1" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding DefaultCategory}" Title="Aucune" MinimumWidthRequest="140" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Mémoriser la dernière catégorie" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Accélère les dépenses habituelles" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding RememberLastCategory}" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Après l’enregistrement" Style="{StaticResource BodyLabel}" VerticalOptions="Center" /><Picker Grid.Column="1" ItemsSource="{Binding AfterSaveChoices}" SelectedItem="{Binding SelectedAfterSaveBehavior}" MinimumWidthRequest="150" /></Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Apparence" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Thème" Style="{StaticResource BodyLabel}" FontAttributes="Bold" /><Label Text="Appliqué immédiatement" Style="{StaticResource MutedLabel}" /></VerticalStackLayout><Picker Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" MinimumWidthRequest="130" /></Grid></Border>

            <Label Text="Catégories" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Créer ou modifier une catégorie" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}"><Entry Placeholder="Nom de la catégorie" Text="{Binding NewCategoryName}" Style="{StaticResource InputEntry}" /></Border>
                    <Border Style="{StaticResource InputField}"><Entry Placeholder="Budget mensuel facultatif" Text="{Binding CategoryBudget}" Keyboard="Numeric" Style="{StaticResource InputEntry}" /></Border>

                    <Grid ColumnDefinitions="64,*" ColumnSpacing="12">
                        <Border WidthRequest="60" HeightRequest="60" BackgroundColor="{Binding SelectedColor}" Stroke="{AppThemeBinding Light={StaticResource OutlineDark}, Dark={StaticResource TextSecondaryDark}}" StrokeThickness="2" StrokeShape="RoundRectangle 18">
                            <Label Text="Aa" TextColor="{Binding SelectedColor, Converter={StaticResource ColorContrastConverter}}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Couleur hexadécimale" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputField}"><Entry Text="{Binding ColorHexInput}" Placeholder="#6750A4" MaxLength="7" Style="{StaticResource InputEntry}" /></Border>
                        </VerticalStackLayout>
                    </Grid>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CategoryColors}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="{x:Null}">
                                    <Button Text=" " BackgroundColor="{Binding .}" WidthRequest="48" HeightRequest="48" CornerRadius="24" Padding="0" Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectSuggestedColorCommand}" CommandParameter="{Binding .}" SemanticProperties.Description="Choisir cette couleur" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="24,*" RowSpacing="5">
                        <Label Text="R" TextColor="#FF6B6B" FontAttributes="Bold" VerticalOptions="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red}" MinimumTrackColor="#FF6B6B" />
                        <Label Grid.Row="1" Text="V" TextColor="#51CF66" FontAttributes="Bold" VerticalOptions="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green}" MinimumTrackColor="#51CF66" />
                        <Label Grid.Row="2" Text="B" TextColor="#4DABF7" FontAttributes="Bold" VerticalOptions="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue}" MinimumTrackColor="#4DABF7" />
                    </Grid>

                    <Button Text="{Binding CategorySaveText}" Command="{Binding SaveCategoryCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button IsVisible="{Binding IsEditingCategory}" Text="Annuler la modification" Command="{Binding CancelCategoryEditCommand}" Style="{StaticResource TextButton}" />

                    <Label Text="Touchez le crayon pour modifier le nom, la couleur ou le budget." Style="{StaticResource MutedLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="domain:Category">
                                <Grid ColumnDefinitions="20,*,48,48" ColumnSpacing="8" MinimumHeightRequest="52">
                                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditCategoryCommand}" CommandParameter="{Binding .}" /></Grid.GestureRecognizers>
                                    <Border HeightRequest="18" WidthRequest="18" BackgroundColor="{Binding Color}" StrokeThickness="0" StrokeShape="RoundRectangle 9" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                                    <ImageButton Grid.Column="2" Source="icon_edit.png" Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditCategoryCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" Padding="12" SemanticProperties.Description="Modifier cette catégorie" />
                                    <ImageButton Grid.Column="3" Source="icon_delete.png" Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteCategoryCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" Padding="12" SemanticProperties.Description="Supprimer cette catégorie" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Mes données" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Export CSV" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                    <Label Text="Crée une copie lisible de l’historique des dépenses." Style="{StaticResource MutedLabel}" />
                    <Button Text="Exporter les dépenses" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                    <Label Text="Sauvegarde complète chiffrée" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                    <Label Text="Le même mot de passe sera nécessaire pour restaurer le fichier." Style="{StaticResource MutedLabel}" />
                    <Border Style="{StaticResource InputField}"><Entry Placeholder="Mot de passe de sauvegarde (8 caractères minimum)" Text="{Binding BackupPassword}" IsPassword="True" Style="{StaticResource InputEntry}" /></Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Sauvegarder" Command="{Binding CreateBackupCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="1" Text="Restaurer" Clicked="OnRestoreClicked" Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Zone sensible" Style="{StaticResource SectionTitle}" TextColor="{AppThemeBinding Light={StaticResource DangerColor}, Dark={StaticResource DangerDarkColor}}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}" Stroke="{StaticResource DangerColor}">
                <VerticalStackLayout Spacing="9">
                    <Label Text="Supprimer toutes les données financières" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                    <Label Text="Efface définitivement dépenses, revenus, objectifs, abonnements et catégories personnalisées." Style="{StaticResource MutedLabel}" />
                    <Button Text="Tout supprimer" Clicked="OnDeleteAllClicked" Style="{StaticResource DangerButton}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Verrouiller maintenant" Clicked="OnLockClicked" Style="{StaticResource PrimaryButton}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />
            <Label Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light={StaticResource SuccessColor}, Dark={StaticResource SuccessDarkColor}}" HorizontalTextAlignment="Center" />
            <Label x:Name="VersionLabel" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
