<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Finance.Android17.Presentation;assembly=Finance.Android17.Presentation"
             xmlns:local="clr-namespace:Finance.Android17.Maui"
             x:Class="Finance.Android17.Maui.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications"
             NavigationPage.HasNavigationBar="False"
             Style="{StaticResource AppPage}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                    <Label Text="Centre" Style="{StaticResource Eyebrow}" />
                    <Label Text="Notifications" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding Summary}" Style="{StaticResource MutedLabel}" FontSize="14" />
                </VerticalStackLayout>
                <local:IconButton Grid.Column="1" Icon="x" ButtonStyle="Tile" VerticalOptions="Start" Description="Fermer les notifications" Clicked="OnCloseClicked" />
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationRow">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <local:IconTile Icon="{Binding Icon}" Tone="{Binding Severity}" Size="44" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" Style="{StaticResource StrongLabel}" />
                                    <Label Text="{Binding Message}" Style="{StaticResource MutedLabel}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" WidthRequest="9" HeightRequest="9" Padding="0" StrokeThickness="0" VerticalOptions="Start" Margin="0,6,0,0"
                                        IsVisible="{Binding IsNew}" BackgroundColor="{StaticResource NotificationDotLight}"
                                        SemanticProperties.Description="Nouvelle alerte">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5" />
                                    </Border.StrokeShape>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border Style="{StaticResource SoftCard}" IsVisible="{Binding IsEmpty}" Padding="24">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <local:IconTile Icon="circle-check" Tone="success" Size="56" HorizontalOptions="Center" />
                    <Label Text="Tout est en ordre" Style="{StaticResource StrongLabel}" HorizontalTextAlignment="Center" />
                    <Label Text="Les budgets proches ou dépassés, un découvert probable et les prélèvements des sept prochains jours apparaîtront ici."
                           Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
