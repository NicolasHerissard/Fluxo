<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Finance.Android17.Presentation;assembly=Finance.Android17.Presentation"
             xmlns:maui="clr-namespace:Finance.Android17.Maui"
             x:Class="Finance.Android17.Maui.CategoriesSettingsPage"
             x:Name="Page"
             x:DataType="vm:CategoriesSettingsViewModel"
             NavigationPage.HasNavigationBar="False"
             Style="{StaticResource AppPage}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="18" MaximumWidthRequest="760" HorizontalOptions="Fill">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                    <Label Text="Réglages" Style="{StaticResource Eyebrow}" />
                    <Label Text="Catégories" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>
                <maui:IconButton Grid.Column="1" Icon="x" ButtonStyle="Tile" VerticalOptions="Start" Description="Retour aux réglages" Clicked="OnBackClicked" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Créer ou modifier une catégorie" Style="{StaticResource StrongLabel}" />
                    <VerticalStackLayout Spacing="4"><Label Text="Nom de la catégorie" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputField}"><Entry Placeholder="Nom de la catégorie" Text="{Binding NewCategoryName}" Style="{StaticResource InputEntry}" SemanticProperties.Description="Nom de la catégorie" /></Border></VerticalStackLayout>
                    <VerticalStackLayout Spacing="4"><Label Text="Budget mensuel (facultatif)" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputField}"><Entry Placeholder="Budget mensuel facultatif" Text="{Binding CategoryBudget}" Keyboard="Numeric" Style="{StaticResource InputEntry}" SemanticProperties.Description="Budget mensuel de la catégorie" /></Border></VerticalStackLayout>

                    <Grid ColumnDefinitions="64,*" ColumnSpacing="12">
                        <Border WidthRequest="60" HeightRequest="60" BackgroundColor="{Binding SelectedColor}" StrokeThickness="2" StrokeShape="RoundRectangle 16"
                                Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" VerticalOptions="End">
                            <Label Text="Aa" TextColor="{Binding SelectedColor, Converter={StaticResource ColorContrastConverter}}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Couleur hexadécimale" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputField}"><Entry Text="{Binding ColorHexInput}" Placeholder="#6750A4" MaxLength="7" Style="{StaticResource InputEntry}" SemanticProperties.Description="Couleur hexadécimale" /></Border>
                        </VerticalStackLayout>
                    </Grid>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CategoryColors}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="{x:Null}">
                                    <Button Text=" " BackgroundColor="{Binding .}" WidthRequest="48" HeightRequest="48" CornerRadius="24" Padding="0" Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectSuggestedColorCommand}" CommandParameter="{Binding .}" SemanticProperties.Description="Choisir cette couleur" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="24,*" RowSpacing="5">
                        <Label Text="R" TextColor="{StaticResource SliderRedColor}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red}" MinimumTrackColor="{StaticResource SliderRedColor}" SemanticProperties.Description="Rouge" />
                        <Label Grid.Row="1" Text="V" TextColor="{StaticResource SliderGreenColor}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green}" MinimumTrackColor="{StaticResource SliderGreenColor}" SemanticProperties.Description="Vert" />
                        <Label Grid.Row="2" Text="B" TextColor="{StaticResource SliderBlueColor}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue}" MinimumTrackColor="{StaticResource SliderBlueColor}" SemanticProperties.Description="Bleu" />
                    </Grid>

                    <Button Text="{Binding CategorySaveText}" Command="{Binding SaveCategoryCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button IsVisible="{Binding IsEditingCategory}" Text="Annuler la modification" Command="{Binding CancelCategoryEditCommand}" Style="{StaticResource TextButton}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Text="Vos catégories" Style="{StaticResource SectionTitle}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
                <Label Text="Touchez une catégorie pour modifier son nom, sa couleur ou son budget." Style="{StaticResource MutedLabel}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="9">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryItem">
                            <Border Style="{StaticResource Card}" Padding="14,6,8,6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditCategoryCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" MinimumHeightRequest="52" SemanticProperties.Hint="Touchez pour modifier cette catégorie">
                                    <Border HeightRequest="20" WidthRequest="20" BackgroundColor="{Binding Color}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource StrongLabel}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                    <maui:IconButton Grid.Column="2" Icon="pencil" ButtonStyle="Small" VerticalOptions="Center"
                                                     Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditCategoryCommand}" CommandParameter="{Binding .}"
                                                     Description="Modifier cette catégorie" />
                                    <maui:IconButton Grid.Column="3" Icon="trash" ButtonStyle="Small" VerticalOptions="Center"
                                                     Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteCategoryCommand}" CommandParameter="{Binding .}"
                                                     IconColor="{AppThemeBinding Light={StaticResource ExpenseInkLight}, Dark={StaticResource ExpenseInkDark}}"
                                                     Description="Supprimer cette catégorie" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Label Text="{Binding StatusText}" Style="{StaticResource StatusLabel}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding StatusIsError}" Value="True">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ExpenseInkLight}, Dark={StaticResource ExpenseInkDark}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
